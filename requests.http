# Создаем набор тегов.
# не забудь сперва закоммитить строку http_method_names в TagsViewSet
###
POST http://127.0.0.1:8000/api/tags/
Content-Type: application/json

{
  "name": "Завтррак",
  "slug": "breakfast"
}
###
POST http://127.0.0.1:8000/api/tags/
Content-Type: application/json

{
  "name": "Обед",
  "slug": "lunch"
}
###

POST http://127.0.0.1:8000/api/tags/
Content-Type: application/json

{
  "name": "Полдник",
  "slug": "afternoon"
}
###

POST http://127.0.0.1:8000/api/tags/
Content-Type: application/json

{
  "name": "Ужин",
  "slug": "dinner"
}
