# Создаем пользователя.
POST http://127.0.0.1:8000/api/users/
Content-Type: application/json

{
    "email": "Dim8/a2@dima.ru",
    "username": "me",
    "first_name": "Вася",
    "last_name": "Иванов",
    "password": "Password1234!1"
}
###


# Получаем токен для пользователя.
POST http://127.0.0.1:8000/api/auth/token/login/
Content-Type: application/json

{
    "email": "D@d.ru",
    "password": "1"
}
###


# Записываем полученный для пользователя токен
# 9647b2c966f223b4d29ac1b9d1a18427c9f920f9


# Создаем рецепты
POST http://127.0.0.1:8000/api/recipes/
Content-Type: application/json
Authorization:Token 9647b2c966f223b4d29ac1b9d1a18427c9f920f9

{
  "ingredients": [
    {
      "id": "1",
      "amount": "2"
    },
    {
      "id": "2",
      "amount": "2"
    }
  ],
  "tags": [
    "1",
    "2"
  ],
  "image": "data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABAgMAAABieywaAAAACVBMVEUAAAD///9fX1/S0ecCAAAACXBIWXMAAA7EAAAOxAGVKw4bAAAACklEQVQImWNoAAAAggCByxOyYQAAAABJRU5ErkJggg==",
  "name": "Нечто съедобное (это не точно)",
  "text": "Приготовьте как нибудь эти ингредиеты",
  "cooking_time": 5
}
###
